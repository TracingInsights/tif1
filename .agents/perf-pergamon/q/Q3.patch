     """Manage multiple CDN sources with fallback and rate limiting.
 
     The module-level manager (:func:`get_cdn_manager`) reads ``cdns`` and
-    ``cdn_use_minification`` from the config when ``tif1.cdn`` is imported;
+    ``cdn_use_minification`` from the config when it is first requested;
     call :meth:`reload` after ``config.set(...)`` to apply a change.
     """
 
@@ -667,9 +667,20 @@ class CDNManager:
         )
 
 
-_cdn_manager = CDNManager()
+# Pergamon Q3: built on first use rather than at import. A warm-cache load
+# never touches the CDN, and ``CDNManager()`` reads the config and builds the
+# source list (~0.4 ms) that only a fetch needs.
+_cdn_manager: CDNManager | None = None
+_cdn_manager_lock = threading.Lock()
 
 
 def get_cdn_manager() -> CDNManager:
-    """Get global CDN manager instance."""
-    return _cdn_manager
+    """Get global CDN manager instance (created on first call)."""
+    global _cdn_manager
+    manager = _cdn_manager
+    if manager is None:
+        with _cdn_manager_lock:
+            manager = _cdn_manager
+            if manager is None:
+                manager = _cdn_manager = CDNManager()
+    return manager
