diff --git a/src/tif1/core_utils/helpers.py b/src/tif1/core_utils/helpers.py
index 6f80aad..3a49461 100644
--- a/src/tif1/core_utils/helpers.py
+++ b/src/tif1/core_utils/helpers.py
@@ -791,12 +791,28 @@ def _probe_direct_blocks() -> bool:
         return False
 
 
-_DIRECT_BLOCKS_OK = _probe_direct_blocks()
+# Pergamon Q3: the round-trip probe runs on first use instead of at import.
+# It costs ~1 ms of frame building plus the lazy ``pyarrow.pandas_compat``
+# import its str column triggers (~1 ms more), which an import-only or
+# laps-only process never needs. Every direct-block entry point (the builders
+# below and the codec in ``frame_codec``) goes through ``_direct_blocks_ok``,
+# so the probe still runs before the first direct block build. ``None`` means
+# "not probed yet"; tests may pin the flag to ``False`` to force the fallback.
+_DIRECT_BLOCKS_OK: bool | None = None
+
+
+def _direct_blocks_ok() -> bool:
+    """Whether direct block assembly may be used (probes pandas internals once)."""
+    global _DIRECT_BLOCKS_OK
+    ok = _DIRECT_BLOCKS_OK
+    if ok is None:
+        ok = _DIRECT_BLOCKS_OK = _probe_direct_blocks()
+    return ok
 
 
